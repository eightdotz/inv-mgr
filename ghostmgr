#!/bin/env python3
import os
import threading as task
import time
import curses
from curses import wrapper
from curses.textpad import Textbox
import sys
import subprocess

height = 0
width = 0
offset = 1
pos = 0

user = os.path.expanduser("~")
config = user+"/.ghostie"
item_directory = config + "/items"
history_file = config + "/history.conf"


colors = {}
screens = {}

items = {}

def main(stdscr):
    global height, width, current_menu
    height, width = stdscr.getmaxyx()
    curses.init_pair(1, curses.COLOR_BLACK, curses.COLOR_WHITE)
    highlight = curses.color_pair(1)

    stdscr.clear()
    stdscr.refresh()
    top_bar = curses.newwin(0, width, 0, 0)
    main_win = curses.newwin(height - 5, width, 2, 0)
    user_input = curses.newwin(1, width - 1, height - 1, 1)
    tbox = Textbox(user_input)
    screens.update({"top": top_bar})
    screens.update({"main": main_win})
    screens.update({"box": user_input})
    screens.update({"text": tbox})
    screens.update({"source": stdscr})
    colors.update({"highlight": highlight})
    while True:
        print_text("Overview", screens["top"], 0)
        current_menu = menus
        print_list()
        if not inps():
            exit()

def manage_inv():
    global current_menu
    while True:
        print_text("Inventory Manager", screens["top"], 0)
        current_menu = ["View Items", "Add New Item", "Edit Current Item", "Delete Item"]
        print_list()
        if not inps():
            return

def view_stats():
    return

def add_item():
    print_text("Add a new item!", screens["top"], 0)
    print_text("(Enter q to quit) Enter the items name:", screens["main"], 1)
    name = type()
    if not name or name == "q":
        return    
    print_text("Enter the items description or characteristics:", screens["main"], 1)
    description = type()
    if description == "q":
        return
    print_text("Enter the quantity:", screens["main"], 1)
    quantity = type()
    if quantity == "q":
        return
    print_text("Enter the price:", screens["main"], 1)
    price = type()
    if price == "q":
        return
    if not description:
        description = "NO DESC"
    if not quantity:
        quantity = "0"
    if not price:
        price = "0"
    with open(item_directory + f"/{name}", "w") as file:
        file.write(f"{name}|{description}|{quantity}|{price}")

def edit_item():
    return

def delete_item():
    global current_menu
    print_text("Delete an item.", screens["top"], 0)
    while True:
        current_menu = os.listdir(item_directory)
        print_list()
        choice = inps()
        if not choice:
            return
        print_text("Type 'yes' to confirm deletion.", screens["main"], 1)
        conf = type().lower()
        if conf == "yes":
            os.remove(item_directory + "/" + choice)
        else:
            continue
        print_text("Item removed!", screens["main"], 1)
        time.sleep(0.1)
        wait()

def view_items():
    global current_menu
    print_text("View Current Items!", screens["top"], 0)
    while True:
        current_menu = os.listdir(item_directory)
        print_list()
        choice = inps()
        if not choice:
            return
        with open(item_directory + "/" + choice, "r") as file:
            name = file.read()
            name, desc, quantity, price = name.split("|")
        print_text(f"{name}:\n{desc}\n\nIn Stock: {quantity}\nListed Price: ${price}\n\nEnter to cont.", screens["main"], 1)
        wait()

def wait():
    screens["main"].getch()


def type():
    inp = screens["text"].edit().strip()
    screens["box"].clear()
    screens["box"].refresh()
    return inp


def print_text(string, screen, y):
    screen.clear()
    screen.addstr(y, 0, string)
    screen.refresh()

def print_list(listy=[]):
    if not listy:
        listy = current_menu
    y = offset
    screens["main"].clear()
    for item in listy:
        screens["main"].addstr(y, 0, item)
        y += 1
    screens["main"].refresh()

def inps():
    global pos
    while True:
        key = screens["main"].getch()
        if key == ord("w") or key == ord("s"):
            pos = select(key, pos)
        elif key == ord("e"):
            new_func = menu_links.get(current_menu[pos])
            if new_func:
                new_func()
                print_list()
                return 1
            else:
                return current_menu[pos]
        elif key == ord("q"):
            pos = 0
            return 0
            #print_list()
        elif key == ord('\x1b'):
            exit()

def select(key, pos):
    if not current_menu:
        return

    if key == ord("s"):
        pos += 1
        if pos >= len(current_menu):
            pos = len(current_menu) - 1
            back = 0
        back = 1
        if pos <= 0:
            back = 0
    elif key == ord("w"):
        pos -= 1
        back = -1
        if pos < 0:
            pos = 0
            back = 0
    screens["main"].addstr(pos + offset - back, 0, current_menu[pos - back])
    screens["main"].addstr(pos + offset, 0, current_menu[pos], colors["highlight"])

    return pos

def run_setup():
    if ".ghostie" not in os.listdir(user):
        os.mkdir(config)
    
    if "items" not in os.listdir(config):
        os.mkdir(item_directory)

    if "history.conf" not in os.listdir(config):
        with open(history_file, "w") as file:
            pass
    else:
        with open(history_file, "r") as file:
            pass
    
menu_links = {"Manage Inventory": manage_inv, "View Stats": view_stats, "Add New Item": add_item, "Edit Current Item": edit_item, "Delete Item": delete_item, "View Items": view_items}
menus = []
j = 0
for i in menu_links.keys():
    menus.append(i)
    j += 1
    if j == 2:
        break
current_menu = menus
run_setup()
wrapper(main)
