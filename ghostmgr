def search():
    global current_menu
    while True:
        screens["main"].clear()
        screens["main"].refresh()
        results = os.listdir(item_directory)
        print_text("(q to quit) Search:", screens["top"], 0)
        query = type().lower()
        if query == "q":
            return
        current_menu = []
        while True:
            current_menu = []
            if query:
                for item in results:
                    if query in item.lower():
                        current_menu.append(item)
            else:
                current_menu = results
            print_text(f"Search: {query}", screens["top"], 0)
            if not current_menu:
                print_text("No results!", screens["main"], 1)
                wait()
                break
            print_list()
            name = inps()
            if not name:
                break
            while True:
                current_menu = ["View", "Sell", "Restock", "Edit", "Delete"]
                print_list()
                choice = quick_inps()
                if not choice:
                    break
                new_func = menu_links.get(current_menu[pos])
                if new_func:
                    new_func(name)
                    print_list()
        

