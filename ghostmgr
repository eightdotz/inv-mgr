def wait():
    screens["main"].getch()


def type(prefill=""):
    if prefill:
        screens["box"].addstr(0, 0, prefill)
        screens["box"].move(0, len(prefill))
    inp = screens["text"].edit().strip()
    screens["box"].clear()
    screens["box"].refresh()
    return inp


def print_text(string, screen, y):
    screen.clear()
    screen.addstr(y, 0, string)
    screen.refresh()

def print_list(listy=[]):
    if not listy:
        listy = current_menu
    y = offset
    screens["main"].clear()
    for item in listy:
        screens["main"].addstr(y, 0, item)
        y += 1
    screens["main"].refresh()

def inps():
    global pos
    pos = 0
    while True:
        key = screens["main"].getch()
        if key == ord("w") or key == ord("s"):
            pos = select(key, pos)
        elif key == ord("e"):
            new_func = menu_links.get(current_menu[pos])
            if new_func:
                new_func()
                print_list()
                return 1
            else:
                return current_menu[pos]
        elif key == ord("q"):
            pos = 0
            return 0
        elif key == ord('\x1b'):
            exit()

def quick_inps():
    global pos
    pos = 0
    while True:
        key = screens["main"].getch()
        if key == ord("w") or key == ord("s"):
            pos = select(key, pos)
        elif key == ord("e"):
            return current_menu[pos]
        elif key == ord("q"):
            pos = 0
            return 0
        elif key == ord('\x1b'):
            exit()


def select(key, pos):
    if not current_menu:
        return 0

    if key == ord("s"):
        pos += 1
        if pos >= len(current_menu):
            pos = len(current_menu) - 1
            back = 0
        back = 1
        if pos <= 0:
            back = 0
    elif key == ord("w"):
        pos -= 1
        back = -1
        if pos < 0:
            pos = 0
            back = 0
    if pos - back > -1 and pos - back < len(current_menu):
        screens["main"].addstr(pos + offset - back, 0, current_menu[pos - back])
    screens["main"].addstr(pos + offset, 0, current_menu[pos], colors["highlight"])

    return pos

