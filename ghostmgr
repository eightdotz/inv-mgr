def selling_history():
    item_data = {}
    formatted_items = []
    with open(history_file, "r") as file:
        data = file.readlines()
        if not data:
            print_text(f"No items have been sold, there is nothing to display. Enter to cont.\nFile data:\n\n{data}", screens["main"], 1)
            wait()
            return

    for item in data:
        name, price = item.split(":")
        name = name.strip()
        price = price.strip()
        if name not in item_data.keys():
            item_data[name] = {"price": int(price), "sold": 1}
        else:
            item_data[name]["price"] += int(price)
            item_data[name]["sold"] += 1
    for name, price in item_data.items():
        formatted_items.append(f"Sold {item_data[name]["sold"]} {name} = ${item_data[name]["price"]}")
    print_list(formatted_items)
    wait()



