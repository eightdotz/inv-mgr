    print_text("Add a new recipe!", screens["top"], 0)
    current_menu = os.listdir(item_directory)
    print_list()
    name = inps()
    if not name:
        return
    parts = {}
    while True:
        print_text("Select parts", screens["top"], 0)
        current_menu = os.listdir(parts_directory)
        current_menu.insert(0, "#Continue")
        print_list()
        choice = inps()
        if choice == "#Continue":
            break
        elif choice:
            print_text("Enter quanity used", screens["top"], 0)
            quantity = type()
            parts.update({choice: quantity})
        else:
            return
    with open(recipe_directory + f"/{name}", "w") as file:
        file.write(f"{name}:\n")
        for part, num in parts.items():
            file.write(f"{part}|{num}\n")
        file.write("END")
    print_text("Recipe saved!", screens["main"], 1)
    wait()
    
def edit_recipe():
    global current_menu
    print_text("Edit recipe", screens["top"], 0)
    while True:
        current_menu = os.listdir(recipe_directory)
        print_list()
        choice = inps()
        if not choice:
            return
        if choice not in os.listdir(recipe_directory):
            print_text("No recipe found!", screens["main"], 0)
            wait()
            continue
        while True:
            parts = {}
            parts_display = []
            with open(recipe_directory + "/" + choice, "r") as file:
                data = file.readlines()
                name = data[0].strip(":")
                for item in data:
                    if "|" in item:
                        key, val = item.split("|")
                        parts.update({key: val})
                        parts_display.append(f"{key}: {val}")
            current_menu = parts_display
            print_list()
            update_choice = inps()
            if not update_choice:
                return
            key, val = update_choice.split(":")
            val = val.strip()
            new_part = type(val)
            if not new_part:
                new_part = val
            parts[key.strip()] = new_part.strip()
            with open(recipe_directory + "/" + choice, "w") as file:
                file.write(choice+":\n")
                for key, val in parts.items():
                    file.write(f"{key}|{val}\n")
                file.write("END") 

def delete_recipe():
    global current_menu
    print_text("Delete an recipe", screens["top"], 0)
    while True:
        current_menu = os.listdir(recipe_directory)
        print_list()
        choice = inps()
        if not choice:
            return
        print_text("Type 'yes' to confirm deletion.", screens["main"], 1)
        conf = type().lower()
        if conf == "yes":
            os.remove(recipe_directory + "/" + choice)
        else:
            continue
        print_text("Item removed!", screens["main"], 1)
        time.sleep(0.1)
        wait()

def view_recipe():
    global current_menu
    print_text("View current recipes", screens["top"], 0)
    while True:
        current_menu = os.listdir(recipe_directory)
        print_list()
        choice = inps()
        if not choice:
            return
        with open(recipe_directory + "/" + choice, "r") as file:
            sorted_data = ""
            all_prices = []
            data = file.readlines()
            for item in data:
                if "|" in item:
                    name, val = item.split("|")
                    if name in os.listdir(parts_directory):
                        name, desc, quantity, unit, price = load_part(name)
                        sorted_data += f"{name}: {val.strip()} {unit} @ ${float(val.strip()) * float(price.strip("$"))}\n"
                        all_prices.append(float(price.strip("$")))
                    else:
                        sorted_data += f"{name}: {val.strip()} (part data not found)\n"
                total = 0
                if all_prices:
                    for item in all_prices:
                        total += item
            print_text(f"Recipe: {data[0].strip(":")}\n{sorted_data}\n\nTotal cost: ${total}", screens["main"], 1)
        wait()

